# Copy to .env.local (gitignored) for local dev. Loaded via Node's --env-file
# flag by the :local npm scripts. Never commit real credentials.

# Matches docker-compose.yml. Keep sslmode=disable: api/db.mjs only skips TLS
# when it sees that in the connection string, and local Postgres has no SSL.
DATABASE_URL=postgres://maple:maple@localhost:5434/maple_dev?sslmode=disable

# Optional. Defaults to 4174.
# PORT=4174

# DEV ONLY: lets the UI save raw game frames into ./fixtures (loopback only). Never set in production.
ENABLE_FIXTURE_UPLOAD=1

# Gate for the /admin editor API (sent as x-admin-token). Unset = the admin API is off.
# ADMIN_TOKEN=change-me-to-a-long-random-string
